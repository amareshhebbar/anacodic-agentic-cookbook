# Copy this file to .env (already gitignored — it will never be committed)
# and fill in only the keys you actually need. Every notebook runs its
# offline/no-key path with none of these set; nbio.show_environment()
# prints which of these are loaded, never their values.
#
#   cp .env.example .env
#
# nbio.bootstrap() loads this file automatically from the repo root, so
# nothing else needs to change — no code to write, just this file.

# ---------------------------------------------------------------------------
# 01-extract  ·  04-handwriting-ocr.ipynb
# ---------------------------------------------------------------------------
# Free tier at https://console.groq.com/keys. The notebook's default vision
# model was retired by Groq on 2026-08-16 — the call is expected to fail
# cleanly until you also set a current vision-capable model below.
GROQ_API_KEY=
GROQ_VISION_MODEL=
GROQ_MODEL=

# ---------------------------------------------------------------------------
# 03-embed  ·  02-openai-embeddings.ipynb
# 04-retrieve  ·  04-llm-chunk-scoring.ipynb  (real LLM scoring, instead of the
#   canned/offline response shapes the notebook falls back to)
# 05-bench  ·  02-deepeval-metrics.ipynb  (real metric scores)
# ---------------------------------------------------------------------------
# https://platform.openai.com/api-keys — paid, no free tier. Needed for the
# real text-embedding-3-large path (3072 dims); GROQ_API_KEY above covers the
# LLM-scoring and DeepEval-judge paths just as well and has a free tier.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# 02-chunk  ·  03-store-backends.ipynb  (the "pinecone" backend flag)
# ---------------------------------------------------------------------------
# Free tier at https://app.pinecone.io. Without this key, run("pinecone", ...)
# stops cleanly with a named ValueError rather than a raw traceback — the
# "chroma" backend needs no key at all and is the default.
PINECONE_API_KEY=

# ---------------------------------------------------------------------------
# 02-chunk  ·  03-store-backends.ipynb  (the "s3vectors" backend flag)
# ---------------------------------------------------------------------------
# Standard AWS credentials, only needed for the S3 Vectors backend stub.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# ---------------------------------------------------------------------------
# 04-retrieve  ·  02-multi-source-fanout.ipynb
# ---------------------------------------------------------------------------
# PubMed, OpenAlex and ClinicalTrials.gov need no key and always run.
# Semantic Scholar is keyless too, but returns a real HTTP 429 without a key
# (this is a documented, reproduced defect, not a bug in the notebook) —
# a free key at https://www.semanticscholar.org/product/api removes it.
SEMANTIC_SCHOLAR_API_KEY=
# https://tavily.com — free tier. Without this, the web-search source stops
# cleanly with a named RuntimeError instead of returning silently empty.
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# 05-bench  ·  02-deepeval-metrics.ipynb
# ---------------------------------------------------------------------------
# Which model DeepEval's LLM-as-judge calls for Faithfulness / Answer
# Relevancy / Contextual Precision / Contextual Recall. Defaults to an
# OpenAI model if unset and OPENAI_API_KEY is present; set this to point the
# judge at a Groq model instead if that's the key you have.
DEEPEVAL_JUDGE_MODEL=
