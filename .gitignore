*.db
*.sqlite
*.sqlite3
*.mlmodel
runs/
.cache/
data/uploads/
data/raw/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/

# Notebooks
.ipynb_checkpoints/

# Frontend / build
node_modules/
dist/
build/

# OS / editor
.DS_Store
.vscode/
.idea/
prds/
